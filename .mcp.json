{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "claude-mem": {
      "type": "stdio",
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\claude-mem\\plugin\\scripts\\mcp-server.cjs"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "figma-desktop": {
      "type": "sse",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "gemini-cli": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@choplin/mcp-gemini-cli"
      ],
      "env": {}
    },
    "drawio": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@drawio/mcp"
      ],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "env": {
        "SERENA_PROJECT_PATH": "D:/work",
        "DISABLE_BROWSER": "true",
        "NO_BROWSER": "true",
        "ENABLE_TOOL_SEARCH": "true"
      }
    }
  }
}
