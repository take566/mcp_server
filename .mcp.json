{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/chrome-devtools-mcp/dist/index.js"
      ],
      "env": {
        "CHROME_CDP_PORT": "9222"
      }
    },
    "claude-mem": {
      "type": "stdio",
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\claude-mem\\plugin\\scripts\\mcp-server.cjs"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "gemini-cli": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "gemini-mcp-tool"
      ],
      "env": {}
    },
    "drawio": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
