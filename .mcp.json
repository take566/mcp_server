      "type": "stdio",
      "command": "colab-mcp",
      "args": [],
      "env": {}
    },
    "arxiv": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/arxiv-mcp/dist/index.js"
      ],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "D:/work/serena",
        "serena",
        "start-mcp-server"
      ],
      "env": {
        "SERENA_PROJECT_PATH": "D:/work",
        "DISABLE_BROWSER": "true",
        "NO_BROWSER": "true",
        "ENABLE_TOOL_SEARCH": "true"
      }
    },
    "google-calendar": {
