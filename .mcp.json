{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/chrome-devtools-mcp/dist/index.js"
      ],
      "env": {
        "CHROME_CDP_PORT": "9222"
      }
    },
    "claude-mem": {
      "type": "stdio",
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\claude-mem\\plugin\\scripts\\mcp-server.cjs"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "gemini-cli": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "gemini-mcp-tool"
      ],
      "env": {}
    },
    "drawio": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@drawio/mcp"
      ],
      "env": {}
    },
    "colab-proxy-mcp": {
      "type": "stdio",
      "command": "py",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "--from",
        "git+https://github.com/googlecolab/colab-mcp",
        "colab-mcp"
      ],
      "env": {}
    },
    "arxiv": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/arxiv-mcp/dist/index.js"
      ],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "py",
      "args": [
        "-m",
        "uv",
        "run",
        "--directory",
        "D:/work/serena",
        "serena",
        "start-mcp-server"
      ],
      "env": {
        "SERENA_PROJECT_PATH": "D:/work",
        "DISABLE_BROWSER": "true",
        "NO_BROWSER": "true",
        "ENABLE_TOOL_SEARCH": "true"
      }
    }
  }
}