{
  "mcpServers": {
    "filesystem": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\tmf58\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-filesystem\\dist\\index.js",
        "D:\\work\\"
      ]
    },
    "brave-search": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\tmf58\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-brave-search\\dist\\index.js"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "notionApi": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "${OPENAPI_MCP_HEADERS}"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "mcp-obsidian": {
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\mcp-obsidian-src\\dist\\index.js",
        "D:\\work\\Obsidian\\Obsidian\\"
      ]
    },
    "toolbox": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/toolbox@latest"
      ]
    },
    "playwright-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@showfive/playwright-mcp-server@latest"
      ]
    },
    "memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@drdee/memory-mcp@latest"
      ]
    },
    "code-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@block/code-mcp@latest"
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["--yes", "@upstash/context7-mcp"],
      "env": {}
    },
    "serena": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "D:/work/serena",
        "serena-mcp-server",
        "--transport",
        "sse",
        "--port",
        "32123"
      ],
      "port": 32123,
      "env": {
        "SERENA_PROJECT_PATH": "D:/work",
        "DISABLE_BROWSER": "true",
        "NO_BROWSER": "true"
      }
    },
    "cipher": {
      "command": "node",
      "args": ["D:\\work\\mcp_server\\configs\\win_config\\load-env-and-run-cipher.cjs"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "CIPHER_EMBEDDER": "local"
      }
    },
    "smart-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@Leghis/smart-thinking@latest"
      ]
    },
    "grepai": {
      "command": "grepai",
      "args": ["mcp-serve", "D:\\work\\mcp_server"]
    }
  }
}