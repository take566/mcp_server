{
  "preferences": {
    "coworkWebSearchEnabled": true,
    "ccdScheduledTasksEnabled": true,
    "coworkScheduledTasksEnabled": true,
    "sidebarMode": "task"
  },
  "mcpServers": {
    "filesystem": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\YOUR_USERNAME\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-filesystem\\dist\\index.js",
        "D:\\work\\"
      ]
    },
    "brave-search": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\YOUR_USERNAME\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-brave-search\\dist\\index.js"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "notionApi": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "mcp-obsidian": {
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\mcp-obsidian-src\\dist\\index.js",
        "D:\\work\\Obsidian\\Obsidian\\"
      ]
    },
    "toolbox": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/toolbox@latest"
      ]
    },
    "playwright-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@showfive/playwright-mcp-server@latest"
      ]
    },
    "memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@drdee/memory-mcp@latest"
      ]
    },
    "code-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "code-mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/chrome-devtools-mcp/dist/index.js"
      ],
      "env": {
        "CHROME_CDP_PORT": "9222"
      }
    },
    "arxiv": {
      "command": "node",
      "args": [
        "D:/work/mcp_server/mcp_servers/arxiv-mcp/dist/index.js"
      ],
      "env": {}
    },
    "claude-mem": {
      "command": "node",
      "args": [
        "d:\\work\\mcp_server\\mcp_servers\\claude-mem\\plugin\\scripts\\mcp-server.cjs"
      ],
      "env": {}
    },
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "storybook": {
      "url": "http://127.0.0.1:6006/mcp"
    },
    "gemini-cli": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@choplin/mcp-gemini-cli",
        "--allow-npx"
      ],
      "env": {}
    },
    "drawio": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@drawio/mcp"
      ],
      "env": {}
    },
    "colab-proxy-mcp": {
      "command": "py",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "--from",
        "git+https://github.com/googlecolab/colab-mcp",
        "colab-mcp"
      ],
      "env": {}
    },
    "serena": {
      "command": "py",
      "args": [
        "-m",
        "uv",
        "run",
        "--directory",
        "D:/work/serena",
        "serena",
        "start-mcp-server"
      ],
      "env": {
        "SERENA_PROJECT_PATH": "D:/work",
        "DISABLE_BROWSER": "true",
        "NO_BROWSER": "true",
        "ENABLE_TOOL_SEARCH": "true"
      }
    },
    "cipher": {
      "command": "node",
      "args": ["D:\\work\\mcp_server\\configs\\win_config\\load-env-and-run-cipher.cjs"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "CIPHER_EMBEDDER": "local"
      }
    },
    "smart-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@Leghis/smart-thinking@latest"
      ]
    },
    "grepai": {
      "command": "grepai",
      "args": ["mcp-serve", "D:\\work\\mcp_server"]
    }
  }
}
