{
    "mcpServers": {
      "filesystem": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/YOUR_USERNAME/Documents/"
        ]
      },
      "brave-search": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-brave-search"
        ],
        "env": {
          "BRAVE_API_KEY": "${BRAVE_API_KEY}"
        }
      },
      "notionApi": {
        "command": "npx",
        "args": [
          "-y",
          "@notionhq/notion-mcp-server"
        ],
        "env": {
          "NOTION_TOKEN": "${NOTION_TOKEN}"
        }
      },
      "github": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "google-analytics": {
        "command": "node",
        "args": ["/Users/YOUR_USERNAME/Documents/mcp_server/google-analytics-mcp/build/index.js"],
        "env": {
          "GOOGLE_CLIENT_EMAIL": "${GOOGLE_CLIENT_EMAIL}",
          "GOOGLE_PRIVATE_KEY": "${GOOGLE_PRIVATE_KEY}",
          "GA_PROPERTY_ID": "${GA_PROPERTY_ID}"
        },
        "disabled": false,
        "alwaysAllow": []
      },
      "arxiv": {
        "command": "uvx",
        "args": ["arxiv-mcp-server"],
        "env": {
          "PATH": "/usr/local/bin:/Users/YOUR_USERNAME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "serena": {
        "command": "/usr/local/bin/uv",
        "args": [
          "run",
          "--directory",
          "/Users/YOUR_USERNAME/Documents/serena",
          "serena-mcp-server",
          "--port",
          "32123"
        ],
        "port": 32123,
        "env": {
          "OPENAI_API_KEY": "${OPENAI_API_KEY}",
          "SERENA_PROJECT_PATH": "/Users/YOUR_USERNAME/Documents/serena",
          "DISABLE_BROWSER": "true",
          "NO_BROWSER": "true"
        }
      }
    }
  } 