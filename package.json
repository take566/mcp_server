{
  "name": "mcp-server-collection",
  "version": "1.0.0",
  "description": "Collection of Model Context Protocol (MCP) servers and development tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "echo \"No tests specified\" && exit 0",
    "format:check": "echo \"No format check specified\" && exit 0",
    "typecheck": "echo \"No typecheck specified\" && exit 0",
    "inspector": "npx -y @modelcontextprotocol/inspector",
    "inspector:drawio": "npx -y @modelcontextprotocol/inspector npx -y @drawio/mcp",
    "inspector:chrome-devtools": "npx -y @modelcontextprotocol/inspector npx -y chrome-devtools-mcp@latest",
    "inspector:context7": "npx -y @modelcontextprotocol/inspector npx -y @upstash/context7-mcp",
    "inspector:claude-mem": "npx -y @modelcontextprotocol/inspector node mcp_servers/claude-mem/plugin/scripts/mcp-server.cjs",
    "inspector:kubernetes": "npx -y @modelcontextprotocol/inspector node mcp_servers/mcp-server-kubernetes/dist/index.js",
    "build:all": "node scripts/build-all.mjs",
    "sync-sdk": "node scripts/sync-sdk.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/take566/mcp_server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "MIT"
}
